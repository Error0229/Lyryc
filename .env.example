# Optional, for development only. Copy to .env (it's gitignored).

# Dev builds also try this key (`env_keys` in src-tauri/src/llm/store.rs);
# release builds ignore them. Normally, add providers in Settings → AI providers.
GEMINI_API_KEY=your_gemini_api_key_here

# Vite dev server port (default 5274). If you change it, change "devUrl" in
# src-tauri/tauri.conf.json too.
VITE_PORT=5274
