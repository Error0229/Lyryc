{
  "manifest_version": 3,
  "name": "Lyryc Music Detector",
  "version": "0.1.0",
  "description": "Detects currently playing music from multiple streaming platforms",
  "minimum_chrome_version": "111",
  
  "permissions": [
    "storage",
    "scripting"
  ],
  
  "host_permissions": [
    "https://open.spotify.com/*",
    "https://music.youtube.com/*",
    "https://music.apple.com/*",
    "https://soundcloud.com/*",
    "ws://localhost:8765/*",
    "http://localhost:8765/*"
  ],
  
  "background": {
    "service_worker": "background.js"
  },
  
  "content_scripts": [
    {
      "matches": [
        "https://open.spotify.com/*"
      ],
      "js": ["spotify-detector.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": ["youtube-detector.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": ["youtube-queue.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://music.apple.com/*"
      ],
      "js": ["apple-music-detector.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://soundcloud.com/*"
      ],
      "js": ["soundcloud-detector.js"],
      "run_at": "document_idle"
    }
  ],
  
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lyryc",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}