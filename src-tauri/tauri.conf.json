{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lyryc",
  "version": "../package.json",
  "identifier": "com.lyryc.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5274",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lyryc - Clean Lyric Viewer",
        "width": 1100,
        "height": 120,
        "minWidth": 480,
        "minHeight": 40,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": true,
        "resizable": false,
        "skipTaskbar": true,
        "center": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "draggable-window",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:default",
            "core:window:allow-start-dragging",
            "core:window:allow-set-ignore-cursor-events",
            "core:window:allow-available-monitors",
            "core:window:allow-primary-monitor",
            "core:window:allow-current-monitor",
            "core:window:allow-set-size",
            "core:window:allow-set-position",
            "core:window:allow-minimize",
            "core:window:allow-unminimize",
            "core:window:allow-show",
            "core:window:allow-hide",
            "core:window:allow-set-skip-taskbar",
            "core:window:allow-close",
            "core:window:allow-set-focus",
            "core:window:allow-set-shadow",
            "core:webview:allow-create-webview-window",
            "opener:default",
            "global-shortcut:default"
          ]
        },
        {
          "identifier": "tray-menu",
          "windows": [
            "tray-menu"
          ],
          "permissions": [
            "core:default",
            "core:window:allow-hide",
            "core:window:allow-set-size"
          ]
        },
        {
          "identifier": "settings-window",
          "windows": [
            "settings"
          ],
          "permissions": [
            "core:default",
            "core:window:allow-close",
            "core:window:allow-minimize",
            "core:window:allow-start-dragging",
            "core:window:allow-toggle-maximize",
            "core:window:allow-internal-toggle-maximize",
            "core:window:allow-set-focus",
            "core:window:allow-show",
            "core:window:allow-hide",
            "opener:default"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Error0229",
    "homepage": "https://github.com/Error0229/Lyryc",
    "shortDescription": "Synced lyrics for whatever is playing in your browser",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE5RDBCMUVGQzExNTlFMTgKUldRWW5oWEI3N0hRcVhhTWtCeW5HdXgybVhIRzlUYm5kOEIzQXlPd0Z3OVhQMkE1R1BzNUNtSzAK",
      "endpoints": [
        "https://github.com/Error0229/Lyryc/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
